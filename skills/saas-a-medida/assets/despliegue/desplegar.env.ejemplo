# Configuración de deploy/desplegar.sh. Copia este fichero como deploy/desplegar.env.
# Sin secretos: las claves y contraseñas van en el .env del servidor, dentro de «compartido».

# Usuario y servidor por SSH. Vacío = despliega en esta máquina (solo para probar el script).
SERVIDOR=usuario@203.0.113.10
# Carpeta de la app en el servidor. Dentro se crean versiones/, compartido/, copias/ y el enlace actual.
RUTA=/srv/mi-app
# Lo que vive fuera de cada versión y se conserva entre despliegues (datos, .env, subidas), separado por espacios.
COMPARTIDO="data .env"
# Rutas que rsync no sube. Ancladas con / al principio: «data» sin barra también excluiría carpetas data de dentro.
EXCLUIR="/.git /node_modules /data /.env /deploy/desplegar.env"
# Comandos
PRUEBAS_LOCALES="npm test"
COMPILAR="npm run build"
INSTALAR="npm ci --omit=dev"
MIGRAR=""
REINICIAR="sudo systemctl restart mi-app"
# Cómo saber que la app responde: una URL que da 200 o un comando en el servidor. Una de las dos es obligatoria.
SALUD=https://mi-app.ejemplo.com/salud
SALUD_CMD=""
# Versiones que se guardan para volver atrás.
CONSERVAR=5
# 1 = despliegue de producción: solo desde RAMA_PRODUCCION, igual que en origin, y sin texto de demo
# (copia comprobar-texto-demo.sh a deploy/). Para la instancia de demo o de pruebas, usa otro fichero
# con PRODUCCION=0 y lánzalo con DESPLEGAR_ENV=deploy/demo.env deploy/desplegar.sh
PRODUCCION=1
RAMA_PRODUCCION=main
